<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoggyPigeon.App.ViewModels"
             xmlns:m="using:SoggyPigeon.App.Services"
             x:Class="SoggyPigeon.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <ScrollViewer Classes="page">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="History" />
            <TextBlock Classes="sub" Text="Past matches, kept on this computer only." />

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:HistoryEntry">
                        <Border Classes="historyRow">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding GameName}" />
                                        <TextBlock Classes="muted" Text="vs" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Opponent}" />
                                    </StackPanel>
                                    <TextBlock Classes="muted" Text="{Binding DetailText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="12,0"
                                           Classes.win="{Binding IsWin}" Classes.loss="{Binding IsLoss}"
                                           Text="{Binding Outcome}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" Margin="0,10,0,0"
                       IsVisible="{Binding !HasEntries}"
                       Text="No matches yet: press SEARCH on the Play page." />

            <Button Classes="ghost" Content="Clear history" Command="{Binding ClearHistoryCommand}"
                    IsVisible="{Binding HasEntries}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" />

            <TextBlock Classes="muted" Margin="0,10,0,0" Text="Soggy Pigeon 0.1.0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
